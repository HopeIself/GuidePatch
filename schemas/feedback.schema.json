{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "product",
        "version",
        "os",
        "language",
        "context"
      ],
      "additionalProperties": false
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,50}$"
    },
    "action_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "actor": {
      "enum": [
        "user",
        "simulation"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "failure"
      ]
    },
    "expected_met": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "revision",
    "environment",
    "step_id",
    "action_index",
    "actor",
    "outcome",
    "expected_met",
    "note",
    "date"
  ],
  "additionalProperties": false
}
